# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na
# Vercel (Project Settings > Environment Variables) para produção.
# Nunca coloque valores neste arquivo: ele é versionado.
#
# "Obrigatória" = sem ela uma parte central do app não funciona.
# "Opcional"    = sem ela só aquele recurso fica desligado (o app sobe normalmente).

# ---------------------------------------------------------------- Supabase

# Obrigatória. URL do projeto Supabase. Pública (vai para o navegador).
NEXT_PUBLIC_SUPABASE_URL=

# Obrigatória. Chave anon/publishable do Supabase. Pública; quem protege os
# dados é a RLS do banco, não o sigilo desta chave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Obrigatória, só servidor. Chave service_role: ignora RLS. Usada pelo cliente
# de serviço (lib/supabase/admin.ts) em cadastro, convites, painel de
# administração, cron e webhooks. NUNCA em variável NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional. O código do app não lê esta variável; ela serve ao Supabase CLI
# (supabase link / supabase db push) para aplicar migrações de supabase/migrations.
SUPABASE_DB_PASSWORD=

# ------------------------------------------------- Administração da plataforma

# Obrigatória para usar /admin. E-mail(s) com acesso à administração da
# plataforma, separados por vírgula. Vazia ou ausente = NINGUÉM acessa (a área
# responde 404 a todos). A conta precisa existir no Supabase Auth com o e-mail
# confirmado. Cadastro e convites recusam estes e-mails. Ver docs/ADMIN.md.
PLATFORM_ADMIN_EMAILS=

# Opcional. "true" exige segundo fator (TOTP, nível AAL2) para entrar em /admin.
# Qualquer outro valor mantém desligado. Cadastre o aplicativo em
# /admin/seguranca antes de ligar. Ver docs/ADMIN.md.
PLATFORM_ADMIN_REQUIRE_MFA=

# ------------------------------------------------------------------- Rotinas

# Obrigatória em produção. Segredo das rotas /api/cron/* (lembretes de cobrança
# e expurgo de clubes cancelados). A Vercel Cron o envia como
# "Authorization: Bearer <valor>"; sem ele as rotas respondem 401.
# Também usado por scripts/seed-demo-club.mjs.
CRON_SECRET=

# ------------------------------------------------------------------- Asaas

# Opcional (obrigatória para cobrar os clubes). Chave de API da conta Asaas DA
# PLATAFORMA — a nossa, que cobra a mensalidade dos clubes (lib/asaas/platform.ts).
# Não é a conta de cada clube: essas ficam cifradas no banco. Chave com "_hmlg_"
# aponta para o sandbox.
ASAAS_API_KEY=

# Opcional. Endereço da API do Asaas para a conta da plataforma. Se ausente, é
# deduzido da chave (sandbox para "_hmlg_", produção nos demais casos).
ASAAS_API_BASE_URL=

# Opcional. Token do webhook GLOBAL /api/webhooks/asaas (cabeçalho
# asaas-access-token), rota antiga do Asaas. Os clubes que conectam a própria
# conta usam um endereço próprio, /api/webhooks/asaas/<token>, com token gerado
# por clube e guardado no banco — esse caminho não depende desta variável. Sem
# ela, a rota global responde 401.
ASAAS_WEBHOOK_TOKEN=

# Opcional (necessária para a baixa automática da mensalidade dos clubes). Token
# do webhook /api/webhooks/asaas-platform, que recebe os pagamentos feitos à
# plataforma. Sem ele a rota responde 401.
ASAAS_PLATFORM_WEBHOOK_TOKEN=

# Opcional (recomendada). Token do webhook /api/webhooks/asaas-withdraw-auth, que
# o Asaas consulta antes de autorizar saques/transferências; este app sempre
# recusa. Sem ele a rota responde 401 e a tela de configuração do clube mostra
# "Não configurado" na validação de saque.
ASAAS_WITHDRAW_WEBHOOK_TOKEN=

# Obrigatória para clubes conectarem a própria conta Asaas. Segredo usado para
# cifrar (AES-256-GCM) a chave de API de cada clube antes de gravar no banco
# (lib/crypto/secrets.ts). Perder ou trocar esta chave torna ilegíveis as chaves
# já gravadas. Guarde uma cópia fora do repositório.
CREDENTIALS_ENCRYPTION_KEY=

# ------------------------------------------------------------- E-mail (Resend)

# Opcional. Chave da Resend para e-mails financeiros (lembretes de cobrança).
# Sem ela o e-mail simplesmente não é enviado (aviso no log do servidor).
RESEND_API_KEY=

# Opcional. Remetente dos e-mails. Se ausente, usa
# "Vértice Performance <no-reply@verticepf.com.br>" (domínio precisa estar
# verificado na Resend).
RESEND_FROM_EMAIL=

# ------------------------------------------------------ Notificações (Web Push)

# Opcional. Chave pública VAPID. Pública (vai para o navegador). Par com a
# privada abaixo; gere com "npx web-push generate-vapid-keys".
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Opcional. Chave privada VAPID, só servidor. Sem as três variáveis VAPID as
# notificações push ficam desligadas.
VAPID_PRIVATE_KEY=

# Opcional. Contato do remetente das notificações, no formato "mailto:voce@dominio.com"
# (ou uma URL https).
VAPID_SUBJECT=

# ----------------------------------------------- Scripts de verificação (opcional)

# Usadas apenas pelos scripts scripts/e2e-*.mjs (login de um treinador de teste).
# Não são lidas pelo app.
E2E_COACH_EMAIL=
E2E_COACH_PASSWORD=
